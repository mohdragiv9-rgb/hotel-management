@model IEnumerable<HotelManagement.Models.Guest>

@{
    ViewData["Title"] = "Guest Management";
}

<div class="container-fluid">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h4><i class="fa fa-user"></i> Guest Management</h4>
        </div>

        <div class="card-body">

            <input type="hidden" id="GuestId" />

            <div class="row">

                <div class="col-md-4">

                    <label>ID Number</label>

                    <input type="text"
                           id="IdProofNumber"
                           class="form-control" />

                </div>
                <div class="col-md-4">
                    <label>Guest Name</label>
                    <input type="text" id="GuestName" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label>Mobile No</label>
                    <input type="text" id="MobileNo" class="form-control" maxlength="10" />
                </div>

               

            </div>

            <br />

            <div class="row">

                <div class="col-md-4">
                    <label>Gender</label>

                    <select id="Gender" class="form-select">
                        <option value="">Select</option>
                        <option>Male</option>
                        <option>Female</option>
                        <option>Other</option>
                    </select>

                </div>

                <div class="col-md-4">

                    <label>ID Proof</label>

                    <select id="IdProofType" class="form-select">

                        <option value="">Select</option>
                        <option>Aadhaar Card</option>
                        <option>PAN Card</option>
                        <option>Passport</option>
                        <option>Driving License</option>

                    </select>

                </div>

                <div class="col-md-4">
                    <label>Email</label>
                    <input type="email" id="Email" class="form-control" />
                </div>

            </div>

            <br />

            <div class="row">

                <div class="col-md-4">

                    <label>Aadhaar Number</label>

                    <input type="text"
                           id="AadhaarNo"
                           class="form-control"
                           maxlength="12" />

                </div>

                <div class="col-md-4">

                    <label>City</label>

                    <select id="City" class="form-select">
                        <option value="">Select</option>
                        <option>Bareilly </option>
                        <option>Pilibhit</option>
                        <option>Bisalpur</option>
                        <option>Barkheda</option>
                    </select>
                </div>

                <div class="col-md-4">

                    <label>State</label>
                    <select id="State" class="form-select">
                        <option value="">Select</option>
                        <option>Uttar Pradesh </option>
                        <option>Uttrakhand</option>
                        <option>Delhi</option>
                        <option>Jaipur</option>
                     </select>
                </div>

            </div>

            <br />

            <div class="row">

                <div class="col-md-4">

                    <label>Country</label>

                    <select id="Country" class="form-select">
                    <option value="">Select</option>
                    <option>India </option>
                    <option>Pakistan</option>
                    <option>Nepal</option>
                    <option>Afganistan</option>
                    </select>
                </div>

                <div class="col-md-4">

                    <label>Pincode</label>

                    <input type="text"
                           id="Pincode"
                           class="form-control"
                           maxlength="6" />

                </div>

                <div class="col-md-4">

                    <label>Address</label>

                    <textarea id="Address"
                              class="form-control"
                              rows="2"></textarea>

                </div>

            </div>

            <br />

            <button type="button" id="btnSave" class="btn btn-success btn-sm px-4" onclick="SaveGuest()">
                <i class="fa fa-save"></i>
                Save
            </button>

            <button type="button"
                    class="btn btn-warning btn-sm px-4 ms-2"
                    onclick="ClearData()">

                Reset

            </button>

        </div>

    </div>

    <br />

    <div class="card shadow">

        <div class="card-header bg-dark text-white">

            <h5>Guest List</h5>

        </div>

        <div class="card-body">

            <table class="table table-bordered table-hover table-striped">

                <thead class="table-primary">

                    <tr>

                        <th>Name</th>
                        <th>Mobile</th>
                        <th>Email</th>
                        <th>Gender</th>
                        <th>ID Proof Type</th>
                        <th>ID Proof Number</th>
                        <th>Aadhaar</th>
                        <th>City</th>
                        <th>State</th>
                        <th>Country</th>
                        <th>Pincode</th>
                        <th>Address</th>
                        <th width="170">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.GuestName</td>
                            <td>@item.MobileNo</td>
                            <td>@item.Email</td>
                            <td>@item.Gender</td>
                            <td>@item.IdProofType</td>
                            <td>@item.IdProofNumber</td>
                            <td>@item.AadhaarNo</td>
                            <td>@item.City</td>
                            <td>@item.State</td>
                            <td>@item.Country</td>
                            <td>@item.Pincode</td>
                            <td>@item.Address</td>

                            <td>

                                <button class="btn btn-primary btn-sm"
                                        onclick="Edit(@item.GuestId)">
                                    Edit
                                </button>

                                <button class="btn btn-danger btn-sm"
                                        onclick="Delete(@item.GuestId)">
                                    Delete
                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script src="~/js/Guest.js"></script>

}


