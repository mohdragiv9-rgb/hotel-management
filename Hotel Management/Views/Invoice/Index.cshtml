@model HotelManagement.Models.InvoiceViewModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <title>Invoice</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

</head>

<body>

    <div class="container mt-4">

        <div class="text-center">

            <h2>@Model.HotelName</h2>

            <p>@Model.HotelAddress</p>

            <p>Mobile : @Model.HotelPhone</p>

            <hr />

            <h3>TAX INVOICE</h3>

        </div>

        <br />

        <div class="row">

            <div class="col-md-6">

                <b>Booking No :</b>

                @Model.BookingNo

            </div>

            <div class="col-md-6 text-end">

                <b>Date :</b>

                @DateTime.Now.ToString("dd/MM/yyyy")

            </div>

        </div>

        <hr />

        <div class="row">

            <div class="col-md-6">

                <b>Guest Name :</b>

                @Model.GuestName

            </div>

            <div class="col-md-6">

                <b>Room Number :</b>

                @Model.RoomNumber

            </div>

        </div>

        <br />

        <div class="row">

            <div class="col-md-6">

                <b>Check-In :</b>

                @Model.CheckInDate.ToString("dd/MM/yyyy")

            </div>

            <div class="col-md-6">

                <b>Check-Out :</b>

                @Model.CheckOutDate.ToString("dd/MM/yyyy")

            </div>

        </div>

        <br />

        <table class="table table-bordered">

            <thead class="table-dark">

                <tr>

                    <th>Description</th>

                    <th class="text-end">Amount</th>

                </tr>

            </thead>

            <tbody>

                <tr>

                    <td>Room Charge</td>

                    <td class="text-end">@Model.RoomCharge</td>

                </tr>

                <tr>

                    <td>Extra Charge</td>

                    <td class="text-end">@Model.ExtraCharge</td>

                </tr>

                <tr>

                    <td>Discount</td>

                    <td class="text-end">@Model.Discount</td>

                </tr>

                <tr>

                    <td>GST</td>

                    <td class="text-end">@Model.GST</td>

                </tr>

                <tr>

                    <th>Grand Total</th>

                    <th class="text-end">@Model.GrandTotal</th>

                </tr>

                <tr>

                    <td>Paid Amount</td>

                    <td class="text-end">@Model.PaidAmount</td>

                </tr>

                <tr>

                    <th>Balance</th>

                    <th class="text-end">@Model.BalanceAmount</th>

                </tr>

            </tbody>

        </table>

        <div class="row">

            <div class="col-md-6">

                <b>Payment Mode :</b>

                @Model.PaymentMode

            </div>

            <div class="col-md-6 text-end">

                <b>Total Stay :</b>

                @Model.TotalDays Days

            </div>

        </div>

        <br /><br />

        <div class="row">

            <div class="col-md-6">

                ____________________

                <br />

                Guest Signature

            </div>

            <div class="col-md-6 text-end">

                ____________________

                <br />

                Authorized Signature

            </div>

        </div>

        <br />

        <div class="text-center">

            <button class="btn btn-primary"
                    onclick="window.print()">

                Print Invoice

            </button>

        </div>

    </div>

</body>

</html>